$ROOT/hooks
--default-mounts-file
$ROOT/mounts.conf
create
--rm
--name
sp-ws-s-0001
--pull=never
--http-proxy=false
--log-driver=none
--ulimit
core=0
--network=none
--no-hosts
--read-only
