--userns=keep-id
--user
1000:1000
--tmpfs
/tmp:rw,noexec,nosuid,nodev,size=1073741824
--pids-limit
512
--cpus
4
--memory
8589934592b
--init
--env-host=false
--hostname
sandbox
-v
$ROOT/home/Documents/research:/workspace/r:ro,nosuid,nodev,bind
-v
