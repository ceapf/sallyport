---
--runtime
$ROOT/bin/crun
--hooks-dir
$ROOT/hooks
create
--rm
--name
sp-ws-s-0001
--pull=never
--http-proxy=false
--log-driver=none
--ulimit
core=0
--network=none
--no-hosts
--read-only
--read-only-tmpfs=false
--cap-drop=ALL
--security-opt
no-new-privileges
--security-opt
seccomp=$ROOT/profiles/seccomp-workspace.json
